{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChemWorld event action",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["add_reagent", "add_component", "add_solvent", "add_catalyst", "heat", "wait", "sample", "quench", "create_container", "transfer_material", "select_vessel", "route_material", "configure_instrument", "configure_control", "queue_control_stage", "set_control_feedback", "advance_control", "pause_control", "resume_control", "add_phase", "add_extractant", "mix", "settle", "separate_phase", "wash", "dry", "concentrate", "transfer", "seed_crystals", "cool_crystallize", "filter_crystals", "resuspend_crystals", "evaporate", "distill", "collect_fraction", "set_flow_rate", "run_flow", "set_flow_stream", "advance_flow", "set_potential", "electrolyze", "terminate", "measure"]
        },
        {"type": "integer", "minimum": 0, "maximum": 42}
      ]
    },
    "vessel": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0, "maximum": 15}]},
    "connection": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0, "maximum": 63}]},
    "pressure_Pa": {"type": "number", "minimum": 50000.0, "maximum": 400000.0},
    "ramp_rate_K_s": {"type": "number", "minimum": 0.001, "maximum": 1.0},
    "control_interval_s": {"type": "number", "minimum": 1.0, "maximum": 60.0},
    "headspace_L": {"type": "number", "minimum": 0.001, "maximum": 0.1},
    "stage_duration_s": {"type": "number", "minimum": 1.0, "maximum": 14400.0},
    "feedback_threshold": {"type": "number", "minimum": 0.0, "maximum": 550000.0},
    "atmosphere": {"oneOf": [{"type": "string", "enum": ["nitrogen", "argon", "air"]}, {"type": "integer", "minimum": 0, "maximum": 2}]},
    "feedback_sensor": {"oneOf": [{"type": "string", "enum": ["temperature", "pressure", "off"]}, {"type": "integer", "minimum": 0, "maximum": 2}]},
    "feedback_direction": {"oneOf": [{"type": "string", "enum": ["above", "below"]}, {"type": "integer", "minimum": 0, "maximum": 1}]},
    "feedback_response": {"oneOf": [{"type": "string", "enum": ["pause", "next_stage"]}, {"type": "integer", "minimum": 0, "maximum": 1}]},
    "payload": {"type": "object"},
    "scan_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "resolution_factor": {"type": "number", "minimum": 0.5, "maximum": 8},
    "dilution_factor": {"type": "number", "minimum": 1, "maximum": 1000},
    "instrument": {
      "oneOf": [
        {"type": "string", "enum": ["hplc", "gc", "uvvis", "ph_meter", "final_assay", "nmr", "ir", "ms"]},
        {"type": "integer", "minimum": 0, "maximum": 7}
      ]
    },
    "phase": {
      "oneOf": [
        {"type": "string", "enum": ["reactor_liquid", "aqueous", "organic"]},
        {"type": "integer", "minimum": 0, "maximum": 2}
      ]
    },
    "target_phase": {
      "oneOf": [
        {"type": "string", "enum": ["reactor_liquid", "aqueous", "organic"]},
        {"type": "integer", "minimum": 0, "maximum": 2}
      ]
    }
  },
  "additionalProperties": true
}
