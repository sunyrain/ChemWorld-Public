{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChemWorld recipe",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ChemWorld event action",
        "type": "object",
        "required": ["operation"],
        "properties": {
          "operation": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["add_reagent", "add_component", "add_solvent", "add_catalyst", "heat", "wait", "sample", "quench", "create_container", "transfer_material", "select_vessel", "route_material", "configure_instrument", "configure_control", "queue_control_stage", "set_control_feedback", "advance_control", "pause_control", "resume_control", "add_phase", "add_extractant", "mix", "settle", "separate_phase", "wash", "dry", "concentrate", "transfer", "seed_crystals", "cool_crystallize", "filter_crystals", "resuspend_crystals", "evaporate", "distill", "collect_fraction", "set_flow_rate", "run_flow", "set_flow_stream", "advance_flow", "set_potential", "electrolyze", "terminate", "measure"]
              },
              {"type": "integer", "minimum": 0, "maximum": 42}
            ]
          },
          "payload": {"type": "object"},
          "instrument": {
            "oneOf": [
              {"type": "string", "enum": ["hplc", "gc", "uvvis", "ph_meter", "final_assay", "nmr", "ir", "ms"]},
              {"type": "integer", "minimum": 0, "maximum": 7}
            ]
          },
          "phase": {
            "oneOf": [
              {"type": "string", "enum": ["reactor_liquid", "aqueous", "organic"]},
              {"type": "integer", "minimum": 0, "maximum": 2}
            ]
          },
          "target_phase": {
            "oneOf": [
              {"type": "string", "enum": ["reactor_liquid", "aqueous", "organic"]},
              {"type": "integer", "minimum": 0, "maximum": 2}
            ]
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
